---
// The StuddyBuddy logo with a live mascot: the lettering is the original PNG
// (mascot painted out), and the mascot is the app's vector "boba" mascot laid
// exactly over where it sat (scale 1.769, same star and shadow positions).
// Hovering the parent tile plays it: a bob, a wink, and the star spinning.
---
<div class="sb-logo" role="img" aria-label="StuddyBuddy logo">
  <img src="/img/studdybuddy/logo-text.png" alt="" />
  <svg viewBox="0 0 100 100" aria-hidden="true">
    <ellipse class="sb-shadow" cx="50" cy="92" rx="28" ry="4" fill="rgba(0,0,0,0.12)" />
    <g class="sb-body">
      <path d="M22 38 Q 18 18 32 22 L 30 38 Z" fill="#96E6A0" stroke="#101A14" stroke-width="2.5" stroke-linejoin="round" />
      <path d="M78 38 Q 82 18 68 22 L 70 38 Z" fill="#96E6A0" stroke="#101A14" stroke-width="2.5" stroke-linejoin="round" />
      <path d="M50 16 C 76 16 86 36 86 56 C 86 76 70 88 50 88 C 30 88 14 76 14 56 C 14 36 24 16 50 16 Z" fill="#96E6A0" stroke="#101A14" stroke-width="3" />
      <ellipse cx="28" cy="60" rx="6" ry="3.5" fill="#FF9DBE" opacity="0.7" />
      <ellipse cx="72" cy="60" rx="6" ry="3.5" fill="#FF9DBE" opacity="0.7" />
      <g>
        <ellipse cx="38" cy="52" rx="4" ry="5" fill="#101A14" />
        <ellipse cx="39.5" cy="50" rx="1.4" ry="1.7" fill="#fff" />
      </g>
      <g class="sb-eye">
        <ellipse cx="62" cy="52" rx="4" ry="5" fill="#101A14" />
        <ellipse cx="63.5" cy="50" rx="1.4" ry="1.7" fill="#fff" />
      </g>
      <path class="sb-wink" d="M57.5 52.5 Q 62 49 66.5 52.5" stroke="#101A14" stroke-width="2.6" fill="none" stroke-linecap="round" />
      <path d="M40 68 Q 50 76 60 68" stroke="#101A14" stroke-width="3" fill="none" stroke-linecap="round" />
      <g transform="translate(82 18)">
        <path class="sb-star" d="M0 -6 L 1.5 -1.5 L 6 0 L 1.5 1.5 L 0 6 L -1.5 1.5 L -6 0 L -1.5 -1.5 Z" fill="#FFD23F" stroke="#101A14" stroke-width="1.5" stroke-linejoin="round" />
      </g>
    </g>
  </svg>
</div>

<style is:global>
  .sb-logo { position: relative; width: 72%; aspect-ratio: 493 / 180; }
  .sb-logo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .sb-logo svg { position: absolute; left: 63.98%; top: 0.92%; width: 35.88%; overflow: visible; }
  .sb-logo .sb-body, .sb-logo .sb-shadow, .sb-logo .sb-eye, .sb-logo .sb-star { transform-box: fill-box; transform-origin: center; }
  .sb-logo .sb-body { transform-origin: 50% 100%; }
  .sb-logo .sb-wink { opacity: 0; }

  /* One 3.2s cycle: ~1.3s of action (two quick hops, a wink, one star turn),
     then ~1.9s of rest before it repeats. Each keyframe carries its own easing
     so hops lift off and land softly instead of moving at one constant curve. */
  .sb-logo svg * { will-change: transform, opacity; }
  .sb-logo.play .sb-body { animation: sb-bob 3.2s infinite; }
  .sb-logo.play .sb-shadow { animation: sb-shadow 3.2s infinite; }
  .sb-logo.play .sb-eye { animation: sb-eye 3.2s infinite; }
  .sb-logo.play .sb-wink { animation: sb-wink 3.2s infinite; }
  .sb-logo.play .sb-star { animation: sb-star 3.2s infinite; }

  @keyframes sb-bob {
    0% { transform: translateY(0) scale(1, 1); animation-timing-function: cubic-bezier(.3, 0, .5, 1); }
    4% { transform: translateY(0) scale(1.05, 0.95); animation-timing-function: cubic-bezier(.2, .7, .4, 1); }
    12% { transform: translateY(-8%) scale(0.98, 1.03); animation-timing-function: cubic-bezier(.5, 0, .8, .4); }
    19% { transform: translateY(0) scale(1.04, 0.96); animation-timing-function: cubic-bezier(.2, .7, .4, 1); }
    26% { transform: translateY(-4%) scale(0.99, 1.01); animation-timing-function: cubic-bezier(.5, 0, .8, .4); }
    33% { transform: translateY(0) scale(1.02, 0.98); animation-timing-function: cubic-bezier(.3, 0, .3, 1); }
    40%, 100% { transform: translateY(0) scale(1, 1); }
  }
  @keyframes sb-shadow {
    0%, 4%, 19%, 33%, 40%, 100% { transform: scale(1); opacity: 1; animation-timing-function: ease-in-out; }
    12% { transform: scale(0.78); opacity: 0.55; animation-timing-function: ease-in-out; }
    26% { transform: scale(0.88); opacity: 0.75; animation-timing-function: ease-in-out; }
  }
  @keyframes sb-eye {
    0%, 15% { transform: scaleY(1); animation-timing-function: cubic-bezier(.5, 0, .7, .4); }
    19%, 27% { transform: scaleY(0.08); animation-timing-function: cubic-bezier(.3, .6, .5, 1); }
    32%, 100% { transform: scaleY(1); }
  }
  @keyframes sb-wink {
    0%, 16% { opacity: 0; }
    19%, 27% { opacity: 1; }
    30%, 100% { opacity: 0; }
  }
  @keyframes sb-star {
    0% { transform: rotate(0) scale(1); animation-timing-function: cubic-bezier(.4, 0, .2, 1); }
    14% { transform: rotate(160deg) scale(1.3); animation-timing-function: cubic-bezier(.3, 0, .2, 1); }
    38%, 100% { transform: rotate(360deg) scale(1); }
  }
  @media (prefers-reduced-motion: reduce) { .sb-logo.play * { animation: none !important; } }
</style>
