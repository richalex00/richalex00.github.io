---
// The StuddyBuddy logo with a live mascot: the lettering is the original PNG
// (mascot painted out), and the mascot is the app's vector "boba" mascot laid
// exactly over where it sat (scale 1.769, same star and shadow positions).
// Hovering the parent tile plays it: a bob and a star spin, then a wink.
---
<div class="sb-logo" role="img" aria-label="StuddyBuddy logo">
  <img src="/img/studdybuddy/logo-text.png" alt="" />
  <svg viewBox="0 0 100 100" aria-hidden="true">
    <ellipse class="sb-shadow" cx="50" cy="92" rx="28" ry="4" fill="rgba(0,0,0,0.12)" />
    <g class="sb-body">
      <path d="M22 38 Q 18 18 32 22 L 30 38 Z" fill="#96E6A0" stroke="#101A14" stroke-width="2.5" stroke-linejoin="round" />
      <path d="M78 38 Q 82 18 68 22 L 70 38 Z" fill="#96E6A0" stroke="#101A14" stroke-width="2.5" stroke-linejoin="round" />
      <path d="M50 16 C 76 16 86 36 86 56 C 86 76 70 88 50 88 C 30 88 14 76 14 56 C 14 36 24 16 50 16 Z" fill="#96E6A0" stroke="#101A14" stroke-width="3" />
      <ellipse cx="28" cy="60" rx="6" ry="3.5" fill="#FF9DBE" opacity="0.7" />
      <ellipse class="sb-blush-r" cx="72" cy="60" rx="6" ry="3.5" fill="#FF9DBE" opacity="0.7" />
      <g class="sb-eye-l">
        <ellipse cx="38" cy="52" rx="4" ry="5" fill="#101A14" />
        <ellipse cx="39.5" cy="50" rx="1.4" ry="1.7" fill="#fff" />
      </g>
      <g class="sb-eye">
        <ellipse cx="62" cy="52" rx="4" ry="5" fill="#101A14" />
        <ellipse class="sb-glint" cx="63.5" cy="50" rx="1.4" ry="1.7" fill="#fff" />
      </g>
      <path class="sb-wink" d="M57 53.5 Q 62 47.5 67 53.5" stroke="#101A14" stroke-width="2.8" fill="none" stroke-linecap="round" stroke-linejoin="round" />
      <path class="sb-mouth" d="M40 68 Q 50 76 60 68" stroke="#101A14" stroke-width="3" fill="none" stroke-linecap="round" />
      <g transform="translate(82 18)">
        <path class="sb-star" d="M0 -6 L 1.5 -1.5 L 6 0 L 1.5 1.5 L 0 6 L -1.5 1.5 L -6 0 L -1.5 -1.5 Z" fill="#FFD23F" stroke="#101A14" stroke-width="1.5" stroke-linejoin="round" />
      </g>
    </g>
  </svg>
</div>

<style is:global>
  .sb-logo { position: relative; width: 72%; aspect-ratio: 493 / 180; }
  .sb-logo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .sb-logo svg { position: absolute; left: 63.98%; top: 0.92%; width: 35.88%; overflow: visible; }
  .sb-logo .sb-body, .sb-logo .sb-shadow, .sb-logo .sb-eye, .sb-logo .sb-eye-l, .sb-logo .sb-wink,
  .sb-logo .sb-blush-r, .sb-logo .sb-mouth, .sb-logo .sb-star { transform-box: fill-box; transform-origin: center; }
  .sb-logo .sb-body { transform-origin: 50% 100%; }
  .sb-logo .sb-wink { opacity: 0; transform: rotate(-14deg) scale(0.7, 0.6); }

  /* One 3.6s cycle: two quick hops while the star turns (~1.3s), a beat of
     stillness, then the wink (~1.4-1.9s), then rest until it repeats. Each
     keyframe carries its own easing so hops lift off and land softly. */
  .sb-logo svg * { will-change: transform, opacity; }
  .sb-logo.play .sb-body { animation: sb-bob 3.6s infinite; }
  .sb-logo.play .sb-shadow { animation: sb-shadow 3.6s infinite; }
  .sb-logo.play .sb-eye { animation: sb-eye 3.6s infinite; }
  .sb-logo.play .sb-wink { animation: sb-wink 3.6s infinite; }
  .sb-logo.play .sb-star { animation: sb-star 3.6s infinite; }
  .sb-logo.play .sb-eye-l { animation: sb-eye-l 3.6s infinite; }
  .sb-logo.play .sb-glint { animation: sb-glint 3.6s infinite; }
  .sb-logo.play .sb-blush-r { animation: sb-blush 3.6s infinite; }
  .sb-logo.play .sb-mouth { animation: sb-mouth 3.6s infinite; }

  @keyframes sb-bob {
    0% { transform: translateY(0) scale(1, 1); animation-timing-function: cubic-bezier(.3, 0, .5, 1); }
    3.6% { transform: translateY(0) scale(1.05, 0.95); animation-timing-function: cubic-bezier(.2, .7, .4, 1); }
    10.7% { transform: translateY(-8%) scale(0.98, 1.03); animation-timing-function: cubic-bezier(.5, 0, .8, .4); }
    16.9% { transform: translateY(0) scale(1.04, 0.96); animation-timing-function: cubic-bezier(.2, .7, .4, 1); }
    23.1% { transform: translateY(-4%) scale(0.99, 1.01); animation-timing-function: cubic-bezier(.5, 0, .8, .4); }
    29.3% { transform: translateY(0) scale(1.02, 0.98); animation-timing-function: cubic-bezier(.3, 0, .3, 1); }
    35.6%, 100% { transform: translateY(0) scale(1, 1); }
  }
  @keyframes sb-shadow {
    0%, 3.6%, 16.9%, 29.3%, 35.6%, 100% { transform: scale(1); opacity: 1; animation-timing-function: ease-in-out; }
    10.7% { transform: scale(0.78); opacity: 0.55; animation-timing-function: ease-in-out; }
    23.1% { transform: scale(0.88); opacity: 0.75; animation-timing-function: ease-in-out; }
  }
  /* The wink (~1.4-1.95s), cartoon style: the right eye squashes to a thin
     line, swaps at that instant for the closed arc (tilted up to the right),
     which overshoots into a little squeeze and settles; opening reverses it.
     Both stay fully opaque, so there's never a ghosted half-eye. Meanwhile the
     cheek lifts, the mouth tips up on that side and the other eye narrows. */
  @keyframes sb-eye {
    0%, 38.9% { transform: translateY(0) scaleY(1); opacity: 1; animation-timing-function: cubic-bezier(.55, 0, .8, .4); }
    41.4% { transform: translateY(-14%) scaleY(0.12); opacity: 1; }
    41.5%, 49.3% { transform: translateY(-14%) scaleY(0.12); opacity: 0; }
    49.4% { transform: translateY(-14%) scaleY(0.12); opacity: 1; animation-timing-function: cubic-bezier(.2, .6, .35, 1); }
    53.5%, 100% { transform: translateY(0) scaleY(1); opacity: 1; }
  }
  /* The eye's highlight would show as a gap in the squashed line; fade it first. */
  @keyframes sb-glint {
    0%, 38.9% { opacity: 1; }
    40.4%, 51.5% { opacity: 0; }
    53.5%, 100% { opacity: 1; }
  }
  @keyframes sb-wink {
    0%, 41.4% { opacity: 0; transform: rotate(-14deg) scale(1.1, 0.35); }
    41.5% { opacity: 1; transform: rotate(-14deg) scale(1.1, 0.35); animation-timing-function: cubic-bezier(.2, .7, .4, 1); }
    43.4% { opacity: 1; transform: rotate(-14deg) scale(0.94, 1.18); animation-timing-function: ease-in-out; }
    45%, 47.8% { opacity: 1; transform: rotate(-14deg) scale(1, 1); animation-timing-function: cubic-bezier(.5, 0, .8, .5); }
    49.3% { opacity: 1; transform: rotate(-14deg) scale(1.1, 0.35); }
    49.4%, 100% { opacity: 0; transform: rotate(-14deg) scale(1.1, 0.35); }
  }
  @keyframes sb-eye-l {
    0%, 39% { transform: scaleY(1); animation-timing-function: ease-in-out; }
    43%, 48.5% { transform: scaleY(0.82); animation-timing-function: ease-in-out; }
    53%, 100% { transform: scaleY(1); }
  }
  @keyframes sb-blush {
    0%, 39% { transform: translateY(0) scale(1); animation-timing-function: ease-in-out; }
    43%, 48.5% { transform: translateY(-30%) scale(1.15, 1.1); animation-timing-function: ease-in-out; }
    53.5%, 100% { transform: translateY(0) scale(1); }
  }
  @keyframes sb-mouth {
    0%, 39% { transform: rotate(0); animation-timing-function: ease-in-out; }
    43%, 48.5% { transform: rotate(-7deg) translateX(3%); animation-timing-function: ease-in-out; }
    53.5%, 100% { transform: rotate(0); }
  }
  @keyframes sb-star {
    0% { transform: rotate(0) scale(1); animation-timing-function: cubic-bezier(.4, 0, .2, 1); }
    12.4% { transform: rotate(160deg) scale(1.3); animation-timing-function: cubic-bezier(.3, 0, .2, 1); }
    33.8%, 100% { transform: rotate(360deg) scale(1); }
  }
</style>
