---
// The lactation-rooms tile: a 64x40 pixel room drawn as a 48-frame strip
// (scratch script room.py). At rest it shows the sunset preset; hovering the
// tile taps the tablet and fades the room through forest, sea and back.
---
<div class="rm-logo" role="img" aria-label="Pixel-art lactation room whose light and wall screen change between presets">
  <div class="rm-strip" data-cycle></div>
</div>

<style is:global>
  .rm-logo { position: relative; width: 100%; height: 100%; overflow: hidden; }
  /* Stepped background, not a sliding transform, so frames stay put on phones (see JellyTile).
     48 frames at 10 fps; frame k sits at k/47 of 100%, so 48 steps run to 48/47. */
  .rm-logo .rm-strip { position: absolute; inset: 0; background: url("/img/lactation/room-strip.png") 0 0 / 4800% 100% no-repeat; image-rendering: pixelated; }
  .rm-logo.play .rm-strip { animation: rm-cycle 4.8s steps(48) infinite; }
  @keyframes rm-cycle { to { background-position-x: calc(100% * 48 / 47); } }
</style>
