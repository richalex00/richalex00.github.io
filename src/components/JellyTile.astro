---
// The Softy tile: a 64x40 pixel jellyfish over a phone, drawn as a 72-frame strip
// (sprite script ~/Documents/Portfolio/mockup-pixel/softy/jelly.py). At rest she's red
// and angry over the scrolling feed; hovering flips the phone face down, she calms
// to blue, then the phone flips back.
---
<div class="jl-logo" role="img" aria-label="Pixel-art jellyfish, angry and red over a scrolling phone, calming to blue when the phone is turned over">
  <div class="jl-strip" data-cycle></div>
</div>

<style is:global>
  .jl-logo { position: relative; width: 100%; height: 100%; overflow: hidden; }
  /* The strip is a background stepped frame by frame. Background position is never
     smoothed by the compositor, so each frame stays put (a sliding transform can
     glide sideways on phones). Frame k sits at k/71 of 100%, so 72 steps run to 72/71. */
  .jl-logo .jl-strip { position: absolute; inset: 0; background: url("/img/softy/tile-strip.png") 0 0 / 7200% 100% no-repeat; image-rendering: pixelated; }
  .jl-logo.play .jl-strip { animation: jl-cycle 7.2s steps(72) infinite; }
  @keyframes jl-cycle { to { background-position-x: calc(100% * 72 / 71); } }
</style>
