---
import { person } from "../data/site";
interface Props { title?: string; description?: string }
const { title, description = `${person.name}, ${person.role} in Stockholm. ${person.subline}` } = Astro.props;
const pageTitle = title ? `${title} | ${person.name}` : `${person.name}, ${person.role}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Arriving through the pixel transition: hide the page until the overlay is drawn -->
    <script is:inline>try { if (sessionStorage.getItem("px-trans")) document.documentElement.classList.add("trans-in"); } catch (e) {}</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Pixelify+Sans:wght@500&family=Spectral:ital@1&display=swap" />
  </head>
  <body>
    <slot />
    <footer class="dither" aria-hidden="true"></footer>
    <script is:inline src="/js/mine.js"></script>
    <script is:inline src="/js/trans.js"></script>
  </body>
</html>

<style is:global>
  :root {
    --paper: #E9E6DA;
    --panel: #DFDBCC;
    --ink: #22302C;
    --pine: #1F4D3F;
    --contour: #4F7D73;
    --raspberry: #A44376;
    --raspberry-text: #983A6C;
    --muted: #56615C;
    --mono: "JetBrains Mono", ui-monospace, monospace;
    --pixel: "Pixelify Sans", var(--mono);
    --serif: "Spectral", Georgia, serif;
    color-scheme: light;
  }
  html.trans-in { background: var(--pine); }
  html.trans-in body { opacity: 0; }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--paper); color: var(--ink); font: 400 15px/1.75 var(--mono); }
  img { max-width: 100%; height: auto; } /* keeps the aspect ratio when an <img> carries width/height attributes */
  a { color: var(--raspberry-text); text-underline-offset: 3px; }
  a:focus-visible, button:focus-visible, summary:focus-visible { outline: 2px solid var(--raspberry); outline-offset: 3px; }
  p { margin: 0 0 1.4em; text-wrap: pretty; }
  ::selection { background: var(--pine); color: var(--paper); }
  .col { max-width: 560px; margin: 0 auto; padding: 8px 16px 0; position: relative; }

  /* Header with a pixel contour map behind the title (drawn by /js/topo.js) */
  .hero { position: relative; display: grid; place-items: center; align-content: center; overflow: hidden; }
  .hero > canvas[data-topo] { position: absolute; inset: 0; width: 100%; height: 100%; image-rendering: pixelated;
    -webkit-mask-image: linear-gradient(#000 60%, transparent); mask-image: linear-gradient(#000 60%, transparent); }

  .dither {
    margin-top: 90px; height: 140px;
    background-image: radial-gradient(var(--contour) 1px, transparent 1.3px);
    background-size: 4px 4px;
    -webkit-mask-image: linear-gradient(transparent, #000);
            mask-image: linear-gradient(transparent, #000);
    opacity: 0.55;
  }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
</style>
