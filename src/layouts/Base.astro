---
import { person } from "../data/site";
interface Props { title?: string; description?: string; image?: string }
const { title, description = `${person.name}, ${person.role} in Stockholm. ${person.subline}`, image = "/og.png" } = Astro.props;
const imageUrl = new URL(image, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = title ? `${title} | ${person.name}` : `${person.name} | ${person.role}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content={person.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Arriving through the pixel transition: hide the page until the overlay is drawn -->
    <script is:inline>try { if (sessionStorage.getItem("px-trans")) document.documentElement.classList.add("trans-in"); } catch (e) {}</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Pixelify+Sans:wght@500&display=swap" />
  </head>
  <body>
    <slot />
    <footer class="dither" aria-hidden="true"></footer>
    <script is:inline src="/js/mine.js"></script>
    <script is:inline src="/js/trans.js"></script>
    <!-- Visitor counts via GoatCounter: no cookies, no personal data. It skips localhost by itself. -->
    <script is:inline data-goatcounter="https://richalex.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
  </body>
</html>

<style is:global>
  :root {
    --paper: #E9E6DA;
    --panel: #DFDBCC;
    --ink: #22302C;
    --pine: #1F4D3F;
    --contour: #4F7D73;
    --raspberry: #A44376;
    --raspberry-text: #983A6C;
    --muted: #56615C;
    --mono: "JetBrains Mono", ui-monospace, monospace;
    --pixel: "Pixelify Sans", var(--mono);
    /* Type: a perfect fourth (×1.333) up from the 15px body; 12 and 13 for small mono UI */
    --fs-xs: 12px; --fs-s: 13px; --fs-0: 15px; --fs-1: 20px;
    --fs-3: 35.5px; --fs-5: 63.2px; --fs-6: 84.3px;
    --lh-body: 26px; --lh-small: 20px;
    /* Space: Fibonacci steps, each about φ (1.618) times the last */
    --s-5: 5px; --s-8: 8px; --s-13: 13px; --s-21: 21px; --s-34: 34px; --s-55: 55px; --s-89: 89px; --s-144: 144px;
    --gutter: 16px;
    --col: 560px;
    --hero-h: 260px;
    /* Pixel cursors from Kenney's Cursor Pixel Pack (CC0, kenney.nl), recoloured to the palette:
       point, look at (anything clickable), mine (the margins, set by mine.js). */
    --cursor: url("/cursors/arrow.png") 2 2, auto;
    --cursor-look: url("/cursors/look.png") 12 12, pointer;
    --cursor-pick: url("/cursors/pick.png") 3 8, crosshair;
    color-scheme: light;
  }
  html.trans-in { background: var(--pine); }
  html.trans-in body { opacity: 0; }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  html { cursor: var(--cursor); }
  a, button, summary, label, [role="button"] { cursor: var(--cursor-look); }
  html.mining, html.mining * { cursor: var(--cursor-pick); }
  body { margin: 0; background: var(--paper); color: var(--ink); font: 400 var(--fs-0)/var(--lh-body) var(--mono); }
  img { max-width: 100%; height: auto; } /* keeps the aspect ratio when an <img> carries width/height attributes */
  a { color: var(--raspberry-text); text-underline-offset: 3px; }
  a:focus-visible, button:focus-visible, summary:focus-visible { outline: 2px solid var(--raspberry); outline-offset: 3px; }
  p { margin: 0 0 var(--s-21); text-wrap: pretty; }
  ::selection { background: var(--pine); color: var(--paper); }
  .col { max-width: var(--col); margin: 0 auto; padding: var(--s-8) var(--gutter) 0; position: relative; }

  /* Header with a pixel contour map behind the title (drawn by /js/topo.js) */
  .hero { position: relative; display: grid; place-items: center; align-content: center; overflow: hidden; }
  .hero > canvas[data-topo] { position: absolute; inset: 0; width: 100%; height: 100%; image-rendering: pixelated;
    -webkit-mask-image: linear-gradient(#000 60%, transparent); mask-image: linear-gradient(#000 60%, transparent); }

  .dither {
    margin-top: var(--s-89); height: var(--s-144);
    background-image: radial-gradient(var(--contour) 1px, transparent 1.3px);
    background-size: 4px 4px;
    -webkit-mask-image: linear-gradient(transparent, #000);
            mask-image: linear-gradient(transparent, #000);
    opacity: 0.55;
  }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
</style>
