---
import { person } from "../data/site";
interface Props { title?: string; description?: string }
const { title, description = `${person.name}, ${person.role} in Stockholm. ${person.subline}` } = Astro.props;
const pageTitle = title ? `${title} | ${person.name}` : `${person.name}, ${person.role}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..100,500..800&family=Spectral:ital,wght@0,400;0,500;0,600;1,400&display=swap" />
  </head>
  <body>
    <header class="top wrap">
      <a class="me" href="/">
        <img src="/img/me.jpg" alt="" width="44" height="44" />
        <span><b>{person.name}</b><br /><span class="muted">{person.role}</span></span>
      </a>
      <span class="chip" id="clock" aria-label="Local time in Stockholm">Stockholm</span>
      <a class="pill" href={`mailto:${person.email}`}>Get in touch</a>
    </header>
    <main><slot /></main>
    <footer class="foot wrap">
      <div>
        <p class="cap foot-big">Let's talk</p>
        <p><a href={`mailto:${person.email}`}>{person.email}</a></p>
      </div>
      <nav aria-label="Elsewhere">
        <a href={person.linkedin}>LinkedIn</a>
        <a href={person.github}>GitHub</a>
        <a href={person.cv}>Download CV</a>
      </nav>
      <p class="muted small">Designed and built by {person.name}, Stockholm, 2026.</p>
    </footer>
    <script>
      const el = document.getElementById("clock");
      const tick = () => {
        if (!el) return;
        const t = new Date().toLocaleString("en-GB", { weekday: "short", hour: "2-digit", minute: "2-digit", timeZone: "Europe/Stockholm" }).replace(",", "");
        el.textContent = `Stockholm ${t}`;
      };
      tick();
      setInterval(tick, 30000);
    </script>
  </body>
</html>

<style is:global>
  :root {
    --paper: #E9E6DA;
    --ink: #22302C;
    --pine: #1F4D3F;
    --contour: #4F7D73;
    --rasp: #A44376;
    --rasp-text: #983A6C;
    --panel: #DFDBCC;
    --muted: #56615C;
    --rule: #CBC6B4;
    --f-cap: "Archivo", "Arial Narrow", system-ui, sans-serif;
    --f-serif: "Spectral", Georgia, serif;
    color-scheme: light;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--paper); color: var(--ink); font: 400 18px/1.6 var(--f-serif); }
  img, video { max-width: 100%; display: block; }
  h1, h2, h3 { margin: 0; text-wrap: balance; }
  p { margin: 0; text-wrap: pretty; }
  a { color: var(--rasp-text); text-decoration-thickness: 1.5px; text-underline-offset: 3px; }
  ::selection { background: var(--pine); color: var(--paper); }
  :focus-visible { outline: 2px solid var(--rasp); outline-offset: 3px; }
  .wrap { max-width: 1180px; margin-inline: auto; padding-inline: 20px; }
  .cap { font-family: var(--f-cap); font-stretch: 62%; font-weight: 800; text-transform: uppercase; letter-spacing: -0.01em; word-spacing: 0.08em; line-height: 0.95; }
  .muted { color: var(--muted); }
  .small { font-size: 0.85rem; }
  .section-title { font-size: clamp(2.4rem, 7vw, 4.4rem); color: var(--pine); }

  .top { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-block: 18px; flex-wrap: wrap; }
  .me { display: flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font-size: 0.95rem; line-height: 1.25; }
  .me img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
  .me b { font-weight: 600; }
  .chip { font-size: 0.85rem; padding: 5px 12px; border-radius: 999px; background: var(--ink); color: var(--paper); display: inline-flex; align-items: center; gap: 8px; font-variant-numeric: tabular-nums; }
  .chip::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--rasp); }
  .pill { background: var(--rasp); color: #fff; text-decoration: none; padding: 9px 18px; border-radius: 999px; font-weight: 500; font-size: 0.95rem; }
  .pill:hover { background: var(--rasp-text); }
  @media (max-width: 560px) { .chip { display: none; } }

  .foot { display: grid; grid-template-columns: 1fr auto; gap: 18px 30px; align-items: end; padding-block: 64px 40px; border-top: 1px solid var(--rule); margin-top: 40px; }
  .foot-big { font-size: clamp(2.6rem, 8vw, 5rem); color: var(--pine); margin-bottom: 8px; }
  .foot nav { display: flex; gap: 22px; flex-wrap: wrap; }
  .foot .small { grid-column: 1 / -1; }
  @media (max-width: 640px) { .foot { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
</style>
