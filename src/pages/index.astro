---
import Base from "../layouts/Base.astro";
import StuddyLogo from "../components/StuddyLogo.astro";
import GalleonLogo from "../components/GalleonLogo.astro";
import RoomTile from "../components/RoomTile.astro";
import JellyTile from "../components/JellyTile.astro";
import { person, projects, experience, education } from "../data/site";
import { size } from "../data/imageSize";

// "Apr 2025 – Sep 2025" -> "2025", "Feb 2024 – Apr 2025" -> "2024–25"
const years = (dates: string) => {
  const y = dates.match(/\d{4}/g) ?? [];
  if (y.length < 2 || y[0] === y[1]) return y[0] ?? dates;
  return `${y[0]}–${y[1].slice(2)}`;
};

// 16x16 pixel icons, drawn from text grids
const glyphs: Record<string, string[]> = {
  Email: ["................","................","################","##............##","#.#..........#.#","#..#........#..#","#...#......#...#","#....#....#....#","#.....####.....#","#..............#","#..............#","#..............#","################","................","................","................"],
  LinkedIn: ["################","################","##..############","##..############","################","##..##...#######","##..##.......###","##..##..###...##","##..##..####..##","##..##..####..##","##..##..####..##","##..##..####..##","##..##..####..##","################","################","................"],
  GitHub: ["....########....","..############..",".##.##....##.##.",".###........###.","##............##","##............##","##............##","##............##","###..........###",".###........###.",".#.###....###.#.","..#.##....##.#..","...###....###...","....##....##....","................","................"],
  CV: ["..##########....","..#.......#.#...","..#.......#..#..","..#.......####..","..#..........#..","..#.######...#..","..#..........#..","..#.########.#..","..#..........#..","..#.########.#..","..#..........#..","..#.#####....#..","..#..........#..","..############..","................","................"],
};
const rects = (rows: string[]) =>
  rows.flatMap((row, y) => [...row].map((ch, x) => (ch === "#" ? `<rect x="${x}" y="${y}" width="1" height="1"/>` : ""))).join("");
// Only the plain image tiles need a size; the others are videos or logo components
const tileDims = await Promise.all(projects.map((p, i) =>
  p.tileVideo || p.tileAnim || p.tile?.animated ? undefined : size(p.tile?.src ?? (i === 0 ? p.cover.src : p.fan)),
));
const contacts = [
  { name: "Email", href: `mailto:${person.email}`, colour: "#22302C" },
  { name: "LinkedIn", href: person.linkedin, colour: "#1F4D3F" },
  { name: "GitHub", href: person.github, colour: "#22302C" },
  { name: "CV", href: person.cv, colour: "#A44376" },
];
---
<Base>
  <header class="hero">
    <canvas data-topo data-topo-clear="h1, .tagline" aria-hidden="true"></canvas>
    <div class="clock" aria-label="Local time in Stockholm"><i></i><span id="clock">Stockholm</span></div>
    <h1>{person.name}</h1>
    <p class="tagline">{person.headline}.</p>
  </header>

  <main class="col">
    <section class="intro">
      <span class="bubble" aria-hidden="true">hej!</span>
      <button class="avatar" aria-label="Photo of Richard" aria-pressed="false">
        <canvas id="avatar" width="32" height="32"></canvas>
        <img src="/img/me.jpg" alt="" decoding="async" fetchpriority="low" />
      </button>
      {person.intro.map((t) => <p>{t}</p>)}
      <p>Here are a few things I've made.</p>
    </section>

    <div class="tiles">
      {projects.map((p, i) => (
        <a class={`tile${i === 0 ? " lead" : ""}${p.tile ? " logo" : ""}${p.tileVideo ? " anim" : ""}`} href={`/work/${p.slug}/`} data-trans>
          <div class="frame" style={p.tile ? `background: ${p.tile.bg}` : p.tileVideo ? `background: ${p.tileVideo.bg}` : undefined}>
            {p.tileVideo
              ? <video src={p.tileVideo.src} poster={p.tileVideo.poster} muted playsinline preload="metadata" aria-label={`${p.title} logo animation`}></video>
              : p.tileAnim === "skull"
              ? <GalleonLogo />
              : p.tileAnim === "room"
              ? <RoomTile />
              : p.tileAnim === "jelly"
              ? <JellyTile />
              : p.tile?.animated
              ? <StuddyLogo />
              : p.tile
              ? <img src={p.tile.src} alt={`${p.title} logo`} {...tileDims[i]} loading={i === 0 ? "eager" : "lazy"} decoding="async" />
              : <img src={i === 0 ? p.cover.src : p.fan} alt={p.cover.alt} {...tileDims[i]} loading={i === 0 ? "eager" : "lazy"} decoding="async" />}
          </div>
          <div class="label"><b>{p.title}</b>{p.demo && <em class="live">live demo</em>}<span>{p.subtitle}</span></div>
        </a>
      ))}
    </div>

    <p>I build things as well as design them. Here's where I learned how. Click a row for the details.</p>

    <div class="log">
      <h2 class="log-head">Work</h2>
      {experience.map((j) => (
        <details>
          <summary><img src={j.logo} alt="" loading="lazy" decoding="async" /><span class="role"><b>{j.title}</b>, {j.company}</span><span class="when">{years(j.dates)}</span></summary>
          <div class="body">
            <ul>{j.bullets.map((b) => <li>{b}</li>)}</ul>
            <div class="tags">{j.place}, {j.dates}. {j.tags.join(", ")}</div>
          </div>
        </details>
      ))}
      <h2 class="log-head">Education</h2>
      {education.map((e) => (
        <details>
          <summary><img src={e.logo} alt="" loading="lazy" decoding="async" /><span class="role"><b>{e.degree}</b></span><span class="when">{years(e.dates)}</span></summary>
          <div class="body"><p class="edu-note">{e.school}, {e.place}. {e.note}</p></div>
        </details>
      ))}
      <a class="cv" href={person.cv}>
        <svg viewBox="0 0 8 8" fill="currentColor" aria-hidden="true"><rect x="3" y="0" width="2" height="4"/><rect x="1" y="3" width="6" height="1"/><rect x="2" y="4" width="4" height="1"/><rect x="3" y="5" width="2" height="1"/><rect x="0" y="7" width="8" height="1"/></svg>
        Download my full CV (PDF)
      </a>
    </div>

    <p>Here's a live snapshot of me:</p>
    <div class="code" aria-label="Live snapshot: based in Stockholm, studying HCI at KTH">
      <div><span class="k">let</span> <span class="v">location</span> = <span class="s">'Stockholm'</span></div>
      <div><span class="k">let</span> <span class="v">route</span> = <span class="s">'Ireland → Netherlands → Sweden'</span></div>
      <div><span class="k">let</span> <span class="v">studying</span> = <span class="s">'HCI @ KTH'</span></div>
      <div><span class="k">let</span> <span class="v">hobbies</span> = [</div>
      {person.hobbies.map((h) => <div>   <span class="s">'{h}'</span>,</div>)}
      <div>]</div>
    </div>

    <p>{person.games}</p>
    <div class="marble">
      <p>{person.lifting}</p>
      <figure>
        <button class="statue-btn" aria-label="Sisyphus carrying a computer uphill. Push him."><canvas id="statue"></canvas></button>
        <figcaption>One must imagine the designer happy.</figcaption>
      </figure>
    </div>

    <p class="thanks">Thanks for stopping by! If you'd like to talk about a role or a project, here's where to find me.</p>
    <nav class="icons" aria-label="Contact">
      {contacts.map((c) => (
        <a href={c.href}><svg viewBox="0 0 16 16" fill={c.colour} aria-hidden="true" set:html={rects(glyphs[c.name])}></svg>{c.name}</a>
      ))}
    </nav>
  </main>
  <script is:inline src="/js/home.js"></script>
  <script is:inline src="/js/topo.js"></script>
  <script is:inline>
    // Animated tiles rest on their final frame and play once on hover or focus.
    // Touch screens have no hover, so there it plays once when scrolled into view.
    (() => {
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const touch = matchMedia("(hover: none)").matches && "IntersectionObserver" in window;
      const play = (v) => { if (v.paused) { v.currentTime = 0; v.play().catch(() => {}); } };
      // Live logos loop while hovered, then finish the current cycle and stop.
      document.querySelectorAll(".sb-logo, .gl-logo, .rm-logo, .jl-logo").forEach((logo) => {
        const tile = logo.closest(".tile");
        let leaving = false;
        const start = () => { leaving = false; logo.classList.add("play"); };
        tile.addEventListener("mouseenter", start);
        tile.addEventListener("focus", start);
        tile.addEventListener("mouseleave", () => { leaving = true; });
        tile.addEventListener("blur", () => { leaving = true; });
        logo.querySelector(".sb-body, [data-cycle]").addEventListener("animationiteration", () => {
          if (leaving) logo.classList.remove("play");
        });
        if (touch) {
          const io = new IntersectionObserver(([e]) => {
            if (e.isIntersecting) { start(); leaving = true; io.disconnect(); }
          }, { threshold: 0.6 });
          io.observe(tile);
        }
      });
      document.querySelectorAll(".tile.anim").forEach((tile) => {
        const v = tile.querySelector("video");
        tile.addEventListener("mouseenter", () => play(v));
        tile.addEventListener("focus", () => play(v));
        // Rest on the poster (the final frame) rather than a decoded first frame.
        v.addEventListener("ended", () => v.load());
        if (touch) {
          const io = new IntersectionObserver(([e]) => {
            if (e.isIntersecting) { play(v); io.disconnect(); }
          }, { threshold: 0.6 });
          io.observe(tile);
        }
      });
    })();
  </script>
</Base>

<style is:global>
  /* Hero height and title; the contour canvas styles live in Base.astro */
  .hero { height: var(--hero-h); }
  .hero h1 { position: relative; margin: 0; font: 500 clamp(44px, 9vw, var(--fs-6))/1 var(--pixel); color: var(--pine); letter-spacing: 0.01em; text-align: center; padding: 0 16px; }
  .tagline { position: relative; margin: var(--s-13) 0 0; padding: 0 16px; text-align: center; font: 400 var(--fs-0)/var(--lh-body) var(--mono); color: var(--muted); text-wrap: balance; }
  .clock { position: absolute; top: 16px; right: 16px; font: 500 12px/1 var(--mono); color: var(--muted); display: flex; align-items: center; gap: 8px; background: var(--paper); padding: 6px 8px; border: 2px solid var(--ink); z-index: 1; }
  .clock i { width: 8px; height: 8px; background: var(--raspberry); display: block; animation: blink 2s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0.25; } }

  /* Avatar + speech bubble */
  /* The photo floats in the first paragraph, four text lines tall (4 × 26px),
     so its edges line up with the text; the bubble's tail lands on its top edge. */
  .intro { position: relative; padding-top: var(--s-34); }
  .intro p:nth-of-type(2) { clear: left; } /* start below the photo, not wrapped round its corner */
  .avatar { position: relative; float: left; top: 0; width: 104px; height: 104px; margin: 0 var(--gutter) var(--s-8) 0; border: 2px solid var(--ink); background: var(--panel); cursor: var(--cursor-look); padding: 0; box-shadow: 3px 3px 0 var(--ink); }
  .avatar canvas, .avatar img { width: 100%; height: 100%; display: block; image-rendering: pixelated; }
  .avatar img { display: none; object-fit: cover; }
  /* hover peeks at the photo; a click keeps it (aria-pressed) until the next click */
  .avatar:hover canvas, .avatar[aria-pressed="true"] canvas { display: none; }
  .avatar:hover img, .avatar[aria-pressed="true"] img { display: block; }
  .avatar.hold:hover canvas { display: block; } /* just clicked back to pixels: stay pixelated until the pointer leaves */
  .avatar.hold:hover img { display: none; }
  .avatar:focus-visible { outline: 2px dashed var(--raspberry); outline-offset: 3px; }
  /* 24px tall + 6px tail: top = avatar top (34) − 30 */
  .bubble { position: absolute; left: 10px; top: 4px; height: 24px; font: 500 12px/16px var(--mono); background: var(--paper); border: 2px solid var(--ink); padding: 2px 7px; white-space: nowrap; }
  .bubble::after { content: ""; position: absolute; left: 8px; bottom: -8px; width: 6px; height: 6px; background: var(--ink); }

  /* Project tiles */
  .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); margin: var(--s-8) 0 var(--s-55); }
  .tile { display: block; color: inherit; text-decoration: none; }
  .tile .frame { aspect-ratio: 16 / 10; border: 2px solid var(--ink); background: var(--panel); box-shadow: 4px 4px 0 var(--ink); overflow: hidden; transition: transform 120ms steps(2), box-shadow 120ms steps(2); }
  .tile.lead { grid-column: 1 / -1; }
  .tile.lead .frame { aspect-ratio: 16 / 8; }
  .tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tile.logo .frame { display: grid; place-items: center; }
  .tile.logo .frame > img { width: 72%; height: auto; object-fit: contain; }
  .tile.anim video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tile:hover .frame, .tile:focus-visible .frame { transform: translate(-2px, -2px) rotate(-1.5deg); box-shadow: 6px 6px 0 var(--raspberry); }
  .tile:nth-child(odd):hover .frame { transform: translate(-2px, -2px) rotate(1.5deg); }
  .tile .label { margin-top: var(--s-13); font-size: var(--fs-s); line-height: var(--lh-small); }
  .tile .label span { color: var(--muted); display: block; text-wrap: balance; }
  .tile .label .live { font: 700 10px/1 var(--mono); font-style: normal; text-transform: uppercase; letter-spacing: 0.06em; color: var(--paper); background: var(--raspberry); padding: 3px 6px; margin-left: 8px; vertical-align: 2px; }

  /* Experience + education log */
  .log { margin: var(--s-8) 0 var(--s-55); }
  .log-head { font: 500 var(--fs-1)/1 var(--pixel); color: var(--pine); margin: var(--s-34) 0 0; padding-bottom: var(--s-13); border-bottom: 2px solid var(--ink); }
  .log-head:first-child { margin-top: 0; }
  .log details { border-bottom: 1px dashed var(--contour); }
  .log summary { list-style: none; cursor: var(--cursor-look); padding: 12px 0; display: grid; grid-template-columns: 22px 1fr auto; gap: 12px; align-items: center; }
  .log summary::-webkit-details-marker { display: none; }
  .log summary img { width: 22px; height: 22px; object-fit: contain; filter: grayscale(1) brightness(0.3); }
  .log summary .role { font-size: var(--fs-s); line-height: var(--lh-small); }
  .log summary .when { font-size: var(--fs-xs); color: var(--muted); text-align: right; white-space: nowrap; }
  .log summary .when::after { content: " +"; color: var(--raspberry-text); font-weight: 700; }
  .log summary:hover .role, .log summary:hover .when, .log summary:focus-visible .role, .log summary:focus-visible .when { color: var(--raspberry-text); }
  .log details[open] .when::after { content: " −"; }
  .log .body { padding: 0 0 var(--s-13) var(--s-34); font-size: var(--fs-s); line-height: 22px; }
  .log .body ul { margin: 0 0 8px; padding-left: 0; list-style: none; }
  .log .body li::before { content: "> "; color: var(--contour); }
  .log .tags { color: var(--muted); font-size: var(--fs-xs); }
  .log .edu-note { margin: 0; }
  .cv { display: inline-flex; align-items: center; gap: 10px; margin-top: var(--s-21); font: 700 var(--fs-s)/1 var(--mono); color: var(--paper); background: var(--raspberry); border: 2px solid var(--ink); box-shadow: 4px 4px 0 var(--ink); padding: 13px 20px; text-decoration: none; transition: transform 0.08s steps(2), box-shadow 0.08s steps(2); }
  .cv svg { width: 12px; height: 12px; shape-rendering: crispEdges; }
  .cv:hover { background: var(--pine); }
  .cv:active { transform: translate(3px, 3px); box-shadow: 1px 1px 0 var(--ink); }

  /* Live snapshot */
  .code { background: var(--ink); color: var(--paper); border: 2px solid var(--ink); box-shadow: 4px 4px 0 var(--pine); padding: var(--s-21); margin: var(--s-8) 0 var(--s-55); font-size: var(--fs-s); line-height: var(--lh-body); counter-reset: line; overflow-x: auto; }
  .code div { white-space: pre; }
  .code div::before { counter-increment: line; content: counter(line); display: inline-block; width: 2ch; margin-right: 18px; color: #6E8079; text-align: right; }
  .k { color: #E58AB8; } .v { color: #9CCFC0; } .s { color: #E8D9A8; }

  /* Sisyphus (marble, 120px sprite at 2x; stacked under the text on phones) */
  .marble { display: grid; grid-template-columns: 1fr 240px; gap: var(--s-21); align-items: center; margin: var(--s-8) 0 var(--s-21); }
  .marble p { margin: 0; }
  .marble figure { margin: 0; }
  .marble canvas { width: 100%; height: auto; display: block; image-rendering: pixelated; }
  .statue-btn { all: unset; display: block; width: 100%; cursor: var(--cursor-look); }
  .statue-btn:focus-visible { outline: 2px solid var(--raspberry); outline-offset: 3px; }
  .marble figcaption { font: 400 var(--fs-xs)/var(--lh-small) var(--mono); color: var(--muted); text-align: center; margin-top: var(--s-8); text-wrap: balance; }

  /* Contact */
  .thanks { margin-top: var(--s-55); }
  /* Equal-width cells, so the icons sit at even intervals whatever the label length */
  .icons { display: flex; justify-content: center; gap: var(--s-21); margin: var(--s-8) 0 0; flex-wrap: wrap; }
  .icons a { display: grid; justify-items: center; gap: var(--s-8); width: 64px; color: var(--ink); text-decoration: none; font-size: var(--fs-xs); line-height: var(--lh-small); }
  .icons svg { width: 44px; height: 44px; shape-rendering: crispEdges; transition: transform 100ms steps(2); }
  .icons a:hover svg { transform: translateY(-3px); }

  @media (max-width: 420px) {
    .tiles { grid-template-columns: 1fr; }
    .icons { gap: var(--s-13); }
    .code { font-size: var(--fs-xs); padding: var(--s-13); }
    .marble { grid-template-columns: 1fr; gap: var(--gutter); }
    .marble figure { width: 240px; max-width: 100%; justify-self: center; }
  }
</style>
