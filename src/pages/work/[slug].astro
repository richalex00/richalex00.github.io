---
import Base from "../../layouts/Base.astro";
import DemoWindow from "../../components/DemoWindow.astro";
import { projects, type Project, type Shot } from "../../data/site";
import { size } from "../../data/imageSize";

export function getStaticPaths() {
  return projects.map((p, i) => ({ params: { slug: p.slug }, props: { p, next: projects[(i + 1) % projects.length] } }));
}
const { p, next } = Astro.props as { p: Project; next: Project };

// Wide shots stand alone; the others pair up side by side.
const group = (shots: Shot[] = []) => {
  const out: Shot[][] = [];
  let buf: Shot[] = [];
  for (const s of shots) {
    if (s.wide) { if (buf.length) out.push(buf); buf = []; out.push([s]); }
    else { buf.push(s); if (buf.length === 2) { out.push(buf); buf = []; } }
  }
  if (buf.length) out.push(buf);
  return out;
};

const dims = Object.fromEntries(await Promise.all(
  [p.cover, ...p.sections.flatMap((s) => s.shots ?? [])].map(async (sh) => [sh.src, await size(sh.src)]),
));
---
<Base title={`${p.title}, ${p.kind}`} description={`${p.title}: ${p.subtitle}.`} image={p.cover.src}>
  <div class="bar">
    <a class="back" href="/" data-trans>
      <svg viewBox="0 0 8 8" fill="currentColor" aria-hidden="true"><rect x="0" y="3" width="8" height="2"/><rect x="1" y="2" width="1" height="4"/><rect x="2" y="1" width="1" height="6"/><rect x="3" y="0" width="1" height="8"/></svg>
      All projects
    </a>
  </div>

  <header class="hero case-hero">
    <canvas data-topo data-topo-clear="h1, .sub" aria-hidden="true"></canvas>
    <h1>{p.title}</h1>
    <p class="sub">{p.subtitle}</p>
  </header>

  <main class="col case">
    <dl class="meta">
      <dt>When</dt><dd>{p.year}</dd>
      <dt>Where</dt><dd>{p.place}</dd>
      <dt>Role</dt><dd>{p.role}</dd>
      <dt>Tools</dt><dd>{p.tools}</dd>
      {p.links && <><dt>Read</dt><dd class="links">{p.links.map((l) => <a href={l.href}>{l.label}</a>)}</dd></>}
    </dl>
    <p>{p.intro}</p>
    {p.demo && <DemoWindow href={p.demo.href} title={p.title} label={p.demo.label} note={p.demo.note} />}
    <figure><img src={p.cover.src} alt={p.cover.alt} {...dims[p.cover.src]} fetchpriority="high" /></figure>

    {p.sections.map((s) => (
      <section>
        <h2>{s.heading}</h2>
        {s.body.map((t) => <p>{t}</p>)}
        {group(s.shots).map((g) => (
          <div class={g.length > 1 ? "pair" : ""}>
            {g.map((sh) => (
              <figure>
                <img src={sh.src} alt={sh.alt} {...dims[sh.src]} loading="lazy" decoding="async" />
                {sh.caption && <figcaption>{sh.caption}</figcaption>}
              </figure>
            ))}
          </div>
        ))}
      </section>
    ))}

    <nav class="next">
      <a href="/" data-trans>All projects</a>
      <a href={`/work/${next.slug}/`} data-trans>Next: {next.title}</a>
    </nav>
  </main>
  <script is:inline src="/js/topo.js"></script>
</Base>

<style is:global>
  /* Floating button over the contours, styled like the homepage clock; fixed so it stays reachable on long pages */
  .bar { position: fixed; top: 16px; left: 16px; z-index: 5; }
  .back { display: inline-flex; align-items: center; gap: 8px; font: 500 12px/1 var(--mono); color: var(--ink); text-decoration: none;
    background: var(--paper); padding: 6px 8px; border: 2px solid var(--ink); }
  .back svg { width: 10px; height: 10px; shape-rendering: crispEdges; }
  .back:hover, .back:focus-visible { background: var(--pine); color: var(--paper); }
  .case-hero { min-height: var(--hero-h); padding: var(--s-55) var(--gutter) var(--s-34); }
  .case-hero h1, .case-hero .sub { position: relative; }
  .case-hero h1 { font: 500 clamp(var(--fs-3), 7vw, var(--fs-5))/1.05 var(--pixel); color: var(--pine); margin: 0 0 var(--s-13); text-align: center; text-wrap: balance; max-width: var(--col); }
  .case-hero .sub { text-align: center; font: 400 var(--fs-0)/var(--lh-body) var(--mono); color: var(--muted); margin: 0; max-width: var(--col); text-wrap: balance; }
  .case { padding-top: var(--s-8); }
  .meta { font-size: var(--fs-xs); line-height: var(--lh-small); color: var(--muted); border-top: 2px solid var(--ink); border-bottom: 1px dashed var(--contour); padding: var(--s-13) 0; margin: 0 0 var(--s-34); display: grid; grid-template-columns: 80px 1fr; gap: var(--s-5) var(--s-13); }
  .meta dt { color: var(--ink); font-weight: 700; }
  .meta dd { margin: 0; }
  .meta .links { display: flex; flex-wrap: wrap; gap: 0 var(--gutter); }
  .case h2 { font: 500 var(--fs-1)/1.2 var(--pixel); color: var(--pine); margin: var(--s-55) 0 var(--s-13); }
  .case figure { margin: var(--s-34) 0; }
  .case figure img { width: 100%; display: block; border: 2px solid var(--ink); box-shadow: 4px 4px 0 var(--ink); background: var(--panel); }
  .case figcaption { font: 400 var(--fs-xs)/var(--lh-small) var(--mono); color: var(--muted); margin-top: var(--s-13); text-wrap: balance; }
  /* Pairs share one frame shape, so their bottoms and captions line up */
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); margin: var(--s-34) 0; }
  .pair figure { margin: 0; }
  .pair img { aspect-ratio: 4 / 3; object-fit: contain; }
  .next { margin: var(--s-89) 0 0; padding-top: var(--gutter); border-top: 2px solid var(--ink); display: flex; justify-content: space-between; font-size: var(--fs-s); gap: var(--s-13); }
  @media (max-width: 420px) { .pair { grid-template-columns: 1fr; } }
</style>
