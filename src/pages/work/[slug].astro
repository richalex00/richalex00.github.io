---
import Base from "../../layouts/Base.astro";
import { projects, type Project } from "../../data/site";

export function getStaticPaths() {
  return projects.map((p, i) => ({ params: { slug: p.slug }, props: { p, next: projects[(i + 1) % projects.length] } }));
}
const { p, next } = Astro.props as { p: Project; next: Project };
---
<Base title={p.title} description={`${p.title}: ${p.subtitle}.`}>
  <article class="wrap case">
    <a class="back" href="/#work">All work</a>
    <header class="head">
      <h1 class="cap">{p.title}</h1>
      <p class="subtitle">{p.subtitle}</p>
    </header>
    <dl class="facts">
      <div><dt>Year</dt><dd>{p.year}</dd></div>
      <div><dt>Where</dt><dd>{p.place}</dd></div>
      <div><dt>Role</dt><dd>{p.role}</dd></div>
      <div><dt>Tools</dt><dd>{p.tools}</dd></div>
    </dl>
    <figure class="cover"><img src={p.cover.src} alt={p.cover.alt} /></figure>
    <p class="intro">{p.intro}</p>

    {p.sections.map((s) => (
      <section class="part">
        <h2 class="cap">{s.heading}</h2>
        <div class="body">{s.body.map((t) => <p>{t}</p>)}</div>
        {s.shots && (
          <div class="shots">
            {s.shots.map((sh) => (
              <figure class={sh.wide ? "wide" : ""}>
                <img src={sh.src} alt={sh.alt} loading="lazy" />
                {sh.caption && <figcaption>{sh.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )}
      </section>
    ))}

    {p.link && <p class="ext"><a class="pill" href={p.link.href}>{p.link.label}</a></p>}

    <a class="next" href={`/work/${next.slug}/`}>
      <span class="muted">Next project</span>
      <span class="cap next-title">{next.title}</span>
    </a>
  </article>
</Base>

<style>
  .case { display: flex; flex-direction: column; gap: 34px; padding-block: 20px 40px; }
  .back { font-size: 0.95rem; align-self: flex-start; }
  .head h1 { font-size: clamp(3.2rem, 11vw, 8rem); color: var(--pine); }
  .subtitle { font-size: clamp(1.3rem, 3vw, 2rem); line-height: 1.2; color: var(--contour); margin-top: 12px; max-width: 32ch; }
  .facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px 28px; margin: 0; padding-block: 18px; border-block: 1px solid var(--rule); }
  .facts dt { font-size: 0.82rem; color: var(--muted); }
  .facts dd { margin: 2px 0 0; font-size: 1rem; }
  @media (max-width: 760px) { .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .cover { margin: 0; border-radius: 8px; overflow: hidden; background: var(--panel); }
  .cover img { width: 100%; max-height: 640px; object-fit: cover; }
  .intro { font-size: clamp(1.25rem, 2.2vw, 1.55rem); line-height: 1.5; max-width: 40ch; }
  .part { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 18px 48px; padding-top: 34px; border-top: 1px solid var(--rule); }
  .part h2 { font-size: clamp(1.8rem, 3.4vw, 2.6rem); color: var(--pine); }
  .body { display: flex; flex-direction: column; gap: 14px; max-width: 62ch; }
  .shots { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; margin-top: 10px; }
  .shots figure { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .shots figure.wide { grid-column: 1 / -1; }
  .shots img { border-radius: 6px; background: var(--panel); width: 100%; }
  .shots figure.wide img { max-height: 620px; object-fit: cover; }
  figcaption { font-style: italic; font-size: 0.92rem; color: var(--muted); }
  @media (max-width: 760px) { .part { grid-template-columns: 1fr; } .shots { grid-template-columns: 1fr; } }
  .ext { display: flex; }
  .next { display: flex; flex-direction: column; gap: 6px; padding-block: 34px 10px; border-top: 1px solid var(--rule); text-decoration: none; color: var(--ink); }
  .next-title { font-size: clamp(2.4rem, 7vw, 4.6rem); color: var(--pine); }
  .next:hover .next-title { color: var(--rasp-text); }
</style>
