---
import Base from "../../layouts/Base.astro";
import { projects, type Project, type Shot } from "../../data/site";

export function getStaticPaths() {
  return projects.map((p, i) => ({ params: { slug: p.slug }, props: { p, next: projects[(i + 1) % projects.length] } }));
}
const { p, next } = Astro.props as { p: Project; next: Project };

// Wide shots stand alone; the others pair up side by side.
const group = (shots: Shot[] = []) => {
  const out: Shot[][] = [];
  let buf: Shot[] = [];
  for (const s of shots) {
    if (s.wide) { if (buf.length) out.push(buf); buf = []; out.push([s]); }
    else { buf.push(s); if (buf.length === 2) { out.push(buf); buf = []; } }
  }
  if (buf.length) out.push(buf);
  return out;
};
---
<Base title={p.title} description={`${p.title}: ${p.subtitle}.`}>
  <div class="bar">
    <a class="back" href="/" data-trans>
      <svg viewBox="0 0 8 8" fill="currentColor" aria-hidden="true"><rect x="0" y="3" width="8" height="2"/><rect x="1" y="2" width="1" height="4"/><rect x="2" y="1" width="1" height="6"/><rect x="3" y="0" width="1" height="8"/></svg>
      Index
    </a>
  </div>

  <main class="col case">
    <h1>{p.title}</h1>
    <p class="sub">{p.subtitle}</p>
    <dl class="meta">
      <dt>When</dt><dd>{p.year}</dd>
      <dt>Where</dt><dd>{p.place}</dd>
      <dt>Role</dt><dd>{p.role}</dd>
      <dt>Tools</dt><dd>{p.tools}</dd>
    </dl>
    <p>{p.intro}</p>
    <figure><img src={p.cover.src} alt={p.cover.alt} /></figure>

    {p.sections.map((s) => (
      <section>
        <h2>{s.heading}</h2>
        {s.body.map((t) => <p>{t}</p>)}
        {group(s.shots).map((g) => (
          <div class={g.length > 1 ? "pair" : ""}>
            {g.map((sh) => (
              <figure>
                <img src={sh.src} alt={sh.alt} loading="lazy" />
                {sh.caption && <figcaption>{sh.caption}</figcaption>}
              </figure>
            ))}
          </div>
        ))}
      </section>
    ))}

    {p.link && <p><a href={p.link.href}>{p.link.label}</a></p>}

    <nav class="next">
      <a href="/" data-trans>Back to index</a>
      <a href={`/work/${next.slug}/`} data-trans>Next: {next.title}</a>
    </nav>
  </main>
</Base>

<style is:global>
  .bar { position: sticky; top: 0; display: flex; align-items: center; padding: 14px 16px; background: var(--paper); z-index: 2; }
  .back { display: inline-flex; align-items: center; gap: 8px; color: var(--ink); text-decoration: none; font-size: 13px; font-weight: 500; }
  .back svg { width: 16px; height: 16px; shape-rendering: crispEdges; }
  .back:hover { color: var(--raspberry-text); }
  .case { padding-top: 24px; }
  .case h1 { font: 500 clamp(36px, 7vw, 56px)/1.05 var(--pixel); color: var(--pine); margin: 24px 0 8px; text-align: center; text-wrap: balance; }
  .case .sub { text-align: center; font: italic 19px/1.4 var(--serif); color: var(--contour); margin: 0 0 32px; }
  .meta { font-size: 12px; color: var(--muted); border-top: 2px solid var(--ink); border-bottom: 1px dashed var(--contour); padding: 10px 0; margin: 0 0 32px; display: grid; grid-template-columns: 80px 1fr; gap: 2px 12px; }
  .meta dt { color: var(--ink); font-weight: 700; }
  .meta dd { margin: 0; }
  .case h2 { font: 700 15px/1.4 var(--mono); margin: 44px 0 12px; }
  .case h2::before { content: "## "; color: var(--contour); }
  .case figure { margin: 24px 0; }
  .case figure img { width: 100%; display: block; border: 2px solid var(--ink); box-shadow: 4px 4px 0 var(--ink); background: var(--panel); }
  .case figcaption { font: italic 15px/1.4 var(--serif); color: var(--contour); margin-top: 10px; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .pair figure { margin: 12px 0; }
  .next { margin: 72px 0 0; padding-top: 16px; border-top: 2px solid var(--ink); display: flex; justify-content: space-between; font-size: 13px; gap: 12px; }
  @media (max-width: 420px) { .pair { grid-template-columns: 1fr; } }
</style>
